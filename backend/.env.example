# Copy to .env (no quotes around values). Same variable names as the old FastAPI backend.
APP_NAME=PDF RAG Application
APP_ENV=development

# --- Required ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings ---
# local = in-process ONNX model, no API key, no credits (fixes the Hugging Face 402 error).
EMBEDDING_PROVIDER=local
# Only used when EMBEDDING_PROVIDER=huggingface:
# HUGGINGFACE_API_TOKEN=hf_xxx
# EMBEDDING_FALLBACK_TO_LOCAL=true

# --- Storage ---
CHROMA_PERSIST_DIR=./chroma_data

# --- CORS (comma separated, no trailing slash) ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
# .env uses Java properties syntax: double the backslashes in regexes.
# CORS_ALLOW_ORIGIN_REGEX=https://.*\\.vercel\\.app

# --- Optional tuning (defaults shown) ---
# PORT=8000
# MAX_UPLOAD_SIZE_BYTES=10485760
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=5
# RELEVANCE_THRESHOLD=0.70
# MAX_CONTEXT_TOKENS=4000
# GROQ_MAX_COMPLETION_TOKENS=1024
# GROQ_TEMPERATURE=0.2
